# ===============================
# CONFIGURACIÓN DE TELEGRAM
# ===============================

# Token del bot de Telegram (lo obtienes de @BotFather)
TELEGRAM_TOKEN="7730705086:AAGALBc61bt-1YfCsmyRt33cUuniHPv-0Rk"

# ID del chat donde se enviarán las alertas
# Puedes usar el ID de tu usuario o el de un grupo donde esté tu bot
TELEGRAM_CHAT_ID="1315284048"

# --- Parámetros del Bot ---
# Nivel de detalle de los logs (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO
# Tiempo de espera en segundos entre cada análisis. 3600 = 1 hora.
SLEEP=3600

# ===============================
# CONFIGURACIÓN OPCIONAL DEL BOT
# ===============================

# Puedes definir valores por defecto para el análisis
# (no es obligatorio, el script ya tiene defaults)
SYMBOL=BTCUSDT
INTERVAL=1h
LIMIT=250
POC=112840.16

# --- Parámetros de la Estrategia (Indicadores y Patrones) ---
# Periodo para la media móvil del volumen.
VOLUME_SMA_PERIOD=20
# Multiplicador para definir un patrón Martillo (sombra inferior > cuerpo * N).
HAMMER_MULTIPLIER=2.0
# Multiplicador para definir una Estrella Fugaz (sombra superior > cuerpo * N).
SHOOTING_STAR_MULTIPLIER=2.0
# Multiplicador para confirmar una señal con volumen (volumen > media * N).
VOLUME_MULTIPLIER=1.5
# Periodo para el cálculo del ATR.
ATR_WINDOW=14
# Periodo para el cálculo de las Bandas de Bollinger.
BOLLINGER_WINDOW=20
# Tolerancia porcentual para considerar la zona POC (ej: 0.005 = 0.5%).
POC_TOLERANCE=0.005
# Periodo para la media móvil del ATR, usada para filtrar baja volatilidad.
ATR_MEAN_PERIOD=50
# Multiplicador para el umbral de volatilidad del ATR (ej: 1.2 para 20% por encima de la media).
ATR_VOLATILITY_MULTIPLIER=1.0

# --- Parámetros de Gestión de Riesgo ---
# Ratio Riesgo/Beneficio para calcular el Take Profit.
RR_RATIO=2.0
# Buffer porcentual para el Stop Loss (ej: 0.002 = 0.2%).
SL_BUFFER=0.002

# --- Parámetros de Backtesting ---
# Nombre del archivo CSV con datos históricos para el backtest.
BACKTEST_FILE="historical_data.csv"
